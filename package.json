{
  "name": "code-exec-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --filter !./apps/expo typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:sandbox": "pnpm --filter @engine/sandbox test:abuse",
    "test:e2e": "pnpm --filter @engine/web test:e2e",
    "migrate": "pnpm --filter @engine/db migrate",
    "seed": "tsx scripts/seed.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "dev:api": "pnpm --filter @engine/api dev",
    "dev:worker": "pnpm --filter @engine/worker dev",
    "dev:web": "pnpm --filter @engine/web dev",
    "expo:web": "bun run --cwd apps/expo web",
    "expo:test": "bun test apps/expo/tests"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^20.16.2",
    "eslint": "^9.9.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@engine/db": "workspace:*",
    "@engine/shared": "workspace:*",
    "@engine/storage": "workspace:*",
    "playwright": "^1.64.1"
  }
}
