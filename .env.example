NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
DATABASE_URL=postgres://app:app@postgres:5432/engine
DATABASE_READ_URL=
# Restricted login for workers (member of worker_role, created by the migrate step)
WORKER_DATABASE_URL=postgres://worker_login:worker-pass@postgres:5432/engine
WORKER_DB_PASSWORD=worker-pass
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=engine-artifacts
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true
RETENTION_DAYS=30
WORKER_ID=
WORKER_SLOTS=
LEASE_SECONDS=30
HEARTBEAT_SECONDS=5
DRAIN_SECONDS=30
SANDBOX_DRIVER=nsjail
SANDBOX_ROOTFS_DIR=/opt/sandbox/rootfs
NSJAIL_BIN=/usr/local/bin/nsjail
