/* Base seccomp-bpf policy for all sandboxed runtimes (kafel syntax, compiled by nsjail). */
/* Composed at run time as:  base_allow, base_errno, base_deny [, lang_extra]  DEFAULT KILL_PROCESS */
/* Anything not listed kills the whole sandboxed process. */
/* Syscalls newer than kafels built-in table are referenced by number (x86_64). */

/* CLONE_NEWNS|NEWCGROUP|NEWUTS|NEWIPC|NEWUSER|NEWPID|NEWNET|NEWTIME */

POLICY base_allow {
  ALLOW {
    /* file I/O */
    read, write, readv, writev, pread64, pwrite64, preadv, pwritev, SYSCALL[327], SYSCALL[328],
    open, openat, close, SYSCALL[436], creat, newstat, newfstat, newlstat, newfstatat, SYSCALL[332],
    lseek, access, faccessat, SYSCALL[439], readlink, readlinkat, getdents, getdents64, getcwd, chdir, fchdir,
    rename, renameat, renameat2, mkdir, mkdirat, rmdir, unlink, unlinkat, link, linkat, symlink, symlinkat,
    chmod, fchmod, fchmodat, umask, truncate, ftruncate, fsync, fdatasync, flock, fallocate, fadvise64,
    utime, utimes, utimensat, futimesat, statfs, fstatfs, sendfile64, splice, tee, SYSCALL[326],
    dup, dup2, dup3, pipe, pipe2, fcntl, ioctl, poll, ppoll, select, pselect6,
    epoll_create, epoll_create1, epoll_ctl, epoll_wait, epoll_pwait, SYSCALL[441], eventfd, eventfd2,
    /* memory */
    mmap, mprotect, munmap, mremap, brk, madvise, msync, mincore, mlock, munlock,
    /* signals and timers */
    rt_sigaction, rt_sigprocmask, rt_sigreturn, rt_sigpending, rt_sigtimedwait, rt_sigsuspend, rt_sigqueueinfo,
    sigaltstack, signalfd, signalfd4, kill, tkill, tgkill, pause, nanosleep, clock_nanosleep, alarm,
    getitimer, setitimer, timer_create, timer_settime, timer_gettime, timer_getoverrun, timer_delete,
    timerfd_create, timerfd_settime, timerfd_gettime, clock_gettime, clock_getres, gettimeofday, time, times,
    /* process info */
    getpid, getppid, gettid, getuid, geteuid, getgid, getegid, getgroups, getresuid, getresgid,
    getpgrp, getpgid, getsid, setpgid, setsid, getrlimit, prlimit64, getrusage, sysinfo, newuname, getpriority,
    getcpu, sched_yield, sched_getaffinity, sched_setaffinity, sched_getparam, sched_getscheduler,
    sched_get_priority_max, sched_get_priority_min,
    /* threads, process lifecycle */
    futex, set_robust_list, get_robust_list, set_tid_address, arch_prctl, prctl,
    SYSCALL[334],  /* rseq */
    SYSCALL[324],  /* membarrier */
    SYSCALL[318],  /* getrandom */
    execve, wait4, waitid, exit, exit_group, restart_syscall, fork, vfork,
    clone(clone_flags, newsp, parent_tidptr, child_tidptr, tls) { (clone_flags & 0x7e020080) == 0 },
    personality(persona) { persona == 0 || persona == 0xffffffff }
  }
}

/* Denied with an error so runtimes that probe for these features fall back cleanly. */
POLICY base_errno {
  ERRNO(38) {
    SYSCALL[435],                              /* clone3: args are opaque to BPF; glibc falls back to clone */
    SYSCALL[425], SYSCALL[426], SYSCALL[427],  /* io_uring_setup / enter / register */
    SYSCALL[329], SYSCALL[330], SYSCALL[331],  /* pkey_* */
    SYSCALL[444], SYSCALL[445], SYSCALL[446],  /* landlock_* */
    SYSCALL[333], io_setup, io_destroy, io_submit, io_getevents, io_cancel,
    mbind, set_mempolicy, get_mempolicy, migrate_pages, move_pages,
    inotify_init, inotify_init1, inotify_add_watch, inotify_rm_watch
  },
  ERRNO(1) {
    /* No sockets of any family: the network namespace has no interfaces either. */
    socket, socketpair,
    chown, fchown, lchown, fchownat, setuid, setgid, setreuid, setregid, setresuid, setresgid, setgroups,
    setfsuid, setfsgid, capget, capset, setpriority, sched_setscheduler, sched_setparam, ioprio_get, ioprio_set,
    getxattr, lgetxattr, fgetxattr, listxattr, llistxattr, flistxattr,
    setxattr, lsetxattr, fsetxattr, removexattr, lremovexattr, fremovexattr,
    mknod, mknodat, sync, syncfs, sync_file_range,
    SYSCALL[434], SYSCALL[424], SYSCALL[438]   /* pidfd_open / pidfd_send_signal / pidfd_getfd */
  }
}

/* Explicitly denied: kill the process. Listed so the intent is reviewable even though DEFAULT also kills. */
POLICY base_deny {
  KILL_PROCESS {
    mount, umount, pivot_root, chroot, ptrace, unshare, setns, keyctl, add_key, request_key,
    SYSCALL[321],  /* bpf */
    perf_event_open, kexec_load, SYSCALL[320], init_module, finit_module, delete_module, reboot,
    swapon, swapoff, acct,
    SYSCALL[323],  /* userfaultfd */
    process_vm_readv, process_vm_writev, open_by_handle_at, name_to_handle_at,
    SYSCALL[428], SYSCALL[429], SYSCALL[430], SYSCALL[431], SYSCALL[432], SYSCALL[433], SYSCALL[442], /* new mount API */
    syslog, quotactl, iopl, ioperm, settimeofday, clock_settime, adjtimex, sethostname, setdomainname,
    vhangup, uselib, lookup_dcookie, fanotify_init, seccomp
  }
}
